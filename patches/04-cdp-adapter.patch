+  // Required by the Hermes V1 CDP back-end via the inspector adapter.
+  // Tasks must run with exclusive access to the runtime — MessageQueueThread
+  // serialises callbacks with JS execution, so posting via runOnQueue gives
+  // the V1 "between JS evaluations" semantic the CDP agent relies on.
+  void enqueueRuntimeTask(
+      std::function<void(HermesRuntime&)> task) override {
+    thread_->runOnQueue(
+        [weakRuntime = std::weak_ptr<HermesRuntime>(runtime_),
+         task = std::move(task)]() {
+          auto runtime = weakRuntime.lock();
+          if (!runtime) {
+            return;
+          }
+          task(*runtime);
+        });
+  }
+
  private:
   std::shared_ptr<HermesRuntime> runtime_;
 
