+  // Required by the Hermes V1 CDP back-end via the inspector adapter.
+  // See HermesExecutorRuntimeAdapter::enqueueRuntimeTask for rationale.
+  void enqueueRuntimeTask(
+      std::function<void(HermesRuntime&)> task) override {
+    std::weak_ptr<HermesRuntime> weakRuntime(hermesRuntime_);
+    messageQueueThread_->runOnQueue(
+        [weakRuntime, task = std::move(task)]() {
+          auto runtime = weakRuntime.lock();
+          if (!runtime) {
+            return;
+          }
+          task(*runtime);
+        });
+  }
+
  private:
   std::shared_ptr<HermesRuntime> hermesRuntime_;
   std::shared_ptr<MessageQueueThread> messageQueueThread_;
