+#
+# Hermes V1 CDP adapter shim. Re-exposes the old hermes/inspector/*
+# API on top of V1's hermes/cdp/* API so that RN 0.79's
+# inspector-modern code compiles unchanged. See CDP_ADAPTER_PLAN.md
+# at the repo root.
+
+cmake_minimum_required(VERSION 3.13)
+set(CMAKE_VERBOSE_MAKEFILE on)
+
+file(GLOB hermesinspectorshim_SRC CONFIGURE_DEPENDS
+        RuntimeAdapter.cpp
+        chrome/*.cpp)
+
+add_library(hermes_inspector_shim
+        OBJECT
+        ${hermesinspectorshim_SRC})
+
+target_compile_options(
+        hermes_inspector_shim
+        PRIVATE
+        -std=c++20
+        -fexceptions
+        -DHERMES_ENABLE_DEBUGGER=1)
+
+target_include_directories(hermes_inspector_shim PUBLIC ${REACT_COMMON_DIR})
+target_link_libraries(hermes_inspector_shim
+        hermes-engine::hermesvm
+        jsi
+        reactnative)
--- a/ReactCommon/hermes/inspector/RuntimeAdapter.h
+++ b/ReactCommon/hermes/inspector/RuntimeAdapter.h
@@ -0,0 +1,60 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+ * Hermes V1 CDP adapter shim. Re-exposes the old hermes/inspector/
+ * RuntimeAdapter API so that RN 0.79's inspector-modern code (which
+ * still includes <hermes/inspector/RuntimeAdapter.h>) compiles unchanged.
+ *
+ * The adapter adds one new virtual, enqueueRuntimeTask, that the V1
+ * CDP back-end requires for posting runtime-thread tasks. Concrete
+ * adapters (HermesExecutorRuntimeAdapter, HermesInstanceRuntimeAdapter)
+ * must override it.
+ */
+
+#pragma once
+
+#include <functional>
+#include <memory>
+
+#include <hermes/hermes.h>
+
+#ifndef INSPECTOR_EXPORT
+#define INSPECTOR_EXPORT __attribute__((visibility("default")))
+#endif
+
+namespace facebook {
+namespace hermes {
+namespace inspector_modern {
+
+class INSPECTOR_EXPORT RuntimeAdapter {
+ public:
+  virtual ~RuntimeAdapter() = 0;
+  virtual HermesRuntime& getRuntime() = 0;
+
+  /// Optional. Default no-op. Old API; some legacy paths invoked this to
+  /// nudge the runtime thread. The V1 CDP back-end does not call it.
+  virtual void tickleJs();
+
+  /// Post a task that runs on the runtime thread (with exclusive access
+  /// to the runtime). The default implementation aborts; concrete
+  /// adapters MUST override. Required by the V1 CDP back-end.
+  virtual void enqueueRuntimeTask(std::function<void(HermesRuntime&)> task);
+};
+
+class INSPECTOR_EXPORT SharedRuntimeAdapter : public RuntimeAdapter {
+ public:
+  explicit SharedRuntimeAdapter(std::shared_ptr<HermesRuntime> runtime);
+  ~SharedRuntimeAdapter() override;
+
+  HermesRuntime& getRuntime() override;
+
+ private:
+  std::shared_ptr<HermesRuntime> runtime_;
+};
+
+} // namespace inspector_modern
+} // namespace hermes
+} // namespace facebook
--- a/ReactCommon/hermes/inspector/RuntimeAdapter.cpp
+++ b/ReactCommon/hermes/inspector/RuntimeAdapter.cpp
@@ -0,0 +1,40 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#include <hermes/inspector/RuntimeAdapter.h>
+
+#include <cstdlib>
+
+namespace facebook {
+namespace hermes {
+namespace inspector_modern {
+
+RuntimeAdapter::~RuntimeAdapter() = default;
+
+void RuntimeAdapter::tickleJs() {}
+
+void RuntimeAdapter::enqueueRuntimeTask(
+    std::function<void(HermesRuntime&)> /*task*/) {
+  // Concrete adapters must override this. Reaching the default means
+  // someone wired an adapter into the V1 CDP back-end without providing
+  // a runtime-thread task queue.
+  std::abort();
+}
+
+SharedRuntimeAdapter::SharedRuntimeAdapter(
+    std::shared_ptr<HermesRuntime> runtime)
+    : runtime_(std::move(runtime)) {}
+
+SharedRuntimeAdapter::~SharedRuntimeAdapter() = default;
+
+HermesRuntime& SharedRuntimeAdapter::getRuntime() {
+  return *runtime_;
+}
+
+} // namespace inspector_modern
+} // namespace hermes
+} // namespace facebook
--- a/ReactCommon/hermes/inspector/chrome/CDPHandler.h
+++ b/ReactCommon/hermes/inspector/chrome/CDPHandler.h
@@ -0,0 +1,122 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+ * Hermes V1 CDP adapter shim. Re-exposes the old
+ * hermes/inspector/chrome/CDPHandler API by delegating to V1's
+ * hermes/cdp/CDPAgent. RN 0.79's inspector-modern code (which still
+ * includes <hermes/inspector/chrome/CDPHandler.h>) compiles unchanged.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include <hermes/inspector/RuntimeAdapter.h>
+
+#ifndef INSPECTOR_EXPORT
+#define INSPECTOR_EXPORT __attribute__((visibility("default")))
+#endif
+
+namespace facebook {
+namespace hermes {
+namespace inspector_modern {
+namespace chrome {
+
+using CDPMessageCallbackFunction = std::function<void(const std::string&)>;
+using OnUnregisterFunction = std::function<void()>;
+
+struct CDPHandlerSessionConfig {
+  bool isRuntimeDomainEnabled{false};
+};
+
+struct CDPHandlerExecutionContextDescription {
+  int32_t id{1};
+  std::string origin;
+  std::string name;
+  std::optional<std::string> auxData;
+  bool shouldSendNotifications{false};
+};
+
+/// Opaque persisted state. Old API exposed this so the integrator could
+/// preserve breakpoints across reloads. We don't try to translate V1's
+/// internal cdp::State across the boundary in MVP — getState returns
+/// nullptr and any incoming state is ignored. A future change can wire
+/// this through if reload-state preservation matters.
+class INSPECTOR_EXPORT State {
+ public:
+  struct Private;
+  explicit State(std::unique_ptr<Private> privateState);
+  ~State();
+  Private& get();
+
+ private:
+  std::unique_ptr<Private> privateState_;
+};
+
+/// CDP front-end shim. Implementation lives in CDPHandler.cpp and
+/// translates calls to the V1 hermes::cdp::CDPAgent.
+class INSPECTOR_EXPORT CDPHandler {
+ public:
+  /// Old API's full create overload. RN 0.79 doesn't call this, but it's
+  /// kept for source-compatibility with anyone else who might.
+  static std::shared_ptr<CDPHandler> create(
+      std::unique_ptr<RuntimeAdapter> adapter,
+      bool waitForDebugger = false,
+      bool processConsoleAPI = true,
+      std::shared_ptr<State> state = nullptr,
+      const CDPHandlerSessionConfig& sessionConfig = {},
+      std::optional<CDPHandlerExecutionContextDescription> ec = std::nullopt);
+
+  /// Deprecated overload accepting a debug-session title. This is the
+  /// one RN's ConnectionDemux::enableDebugging actually calls.
+  static std::shared_ptr<CDPHandler> create(
+      std::unique_ptr<RuntimeAdapter> adapter,
+      const std::string& title,
+      bool waitForDebugger = false,
+      bool processConsoleAPI = true,
+      std::shared_ptr<State> state = nullptr,
+      const CDPHandlerSessionConfig& sessionConfig = {},
+      std::optional<CDPHandlerExecutionContextDescription> ec = std::nullopt);
+
+  ~CDPHandler();
+
+  CDPHandler(const CDPHandler&) = delete;
+  CDPHandler& operator=(const CDPHandler&) = delete;
+
+  std::string getTitle() const;
+
+  /// Lazy two-stage construction: registerCallbacks creates the V1
+  /// CDPAgent (which needs the message callback we're given here).
+  /// Returns false if callbacks are already registered.
+  bool registerCallbacks(
+      CDPMessageCallbackFunction messageCallback,
+      OnUnregisterFunction onUnregister);
+
+  /// Tear down the V1 CDPAgent and invoke the OnUnregister callback.
+  /// Returns false if no callbacks were registered.
+  bool unregisterCallbacks();
+
+  /// Forwards a CDP JSON command to the V1 CDPAgent. No-op if no
+  /// callbacks are registered.
+  void handle(std::string message);
+
+  /// Extract V1 cdp::State for reload preservation. MVP: returns nullptr.
+  std::unique_ptr<State> getState();
+
+ private:
+  class Impl;
+  CDPHandler();
+  std::unique_ptr<Impl> impl_;
+};
+
+} // namespace chrome
+} // namespace inspector_modern
+} // namespace hermes
+} // namespace facebook
--- a/ReactCommon/hermes/inspector/chrome/CDPHandler.cpp
+++ b/ReactCommon/hermes/inspector/chrome/CDPHandler.cpp
@@ -0,0 +1,239 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#include <hermes/inspector/chrome/CDPHandler.h>
+
+#include <hermes/AsyncDebuggerAPI.h>
+#include <hermes/cdp/CDPAgent.h>
+#include <hermes/cdp/CDPDebugAPI.h>
+
+#include <mutex>
+#include <unordered_map>
+#include <utility>
+
+namespace facebook {
+namespace hermes {
+namespace inspector_modern {
+namespace chrome {
+
+// ----- State::Private wraps V1 cdp::State (move-only) ------------------------
+
+struct State::Private {
+  facebook::hermes::cdp::State v1;
+};
+
+State::State(std::unique_ptr<Private> privateState)
+    : privateState_(std::move(privateState)) {}
+
+State::~State() = default;
+
+State::Private& State::get() {
+  return *privateState_;
+}
+
+// ----- Per-runtime CDPDebugAPI registry --------------------------------------
+//
+// CDPDebugAPI owns the AsyncDebuggerAPI for a HermesRuntime; only one should
+// exist per runtime. Multiple CDPHandlers may share it (e.g. two devtools
+// windows), so we refcount.
+//
+// Lifetime keying: the registry uses HermesRuntime* identity. Releases happen
+// when CDPHandler::Impl::~Impl runs, which RN's ConnectionDemux drives during
+// disableDebugging. As long as that ordering holds (handler torn down before
+// runtime), the raw pointer is safe.
+
+namespace {
+
+class CDPDebugAPIRegistry {
+ public:
+  facebook::hermes::cdp::CDPDebugAPI& acquire(HermesRuntime& rt) {
+    std::lock_guard<std::mutex> lock(mu_);
+    auto& entry = map_[&rt];
+    if (!entry.api) {
+      entry.api = facebook::hermes::cdp::CDPDebugAPI::create(rt);
+    }
+    ++entry.refcount;
+    return *entry.api;
+  }
+
+  void release(HermesRuntime& rt) {
+    std::lock_guard<std::mutex> lock(mu_);
+    auto it = map_.find(&rt);
+    if (it == map_.end()) {
+      return;
+    }
+    if (--it->second.refcount == 0) {
+      map_.erase(it);
+    }
+  }
+
+ private:
+  struct Entry {
+    std::unique_ptr<facebook::hermes::cdp::CDPDebugAPI> api;
+    int refcount{0};
+  };
+  std::mutex mu_;
+  std::unordered_map<HermesRuntime*, Entry> map_;
+};
+
+CDPDebugAPIRegistry& registry() {
+  static CDPDebugAPIRegistry instance;
+  return instance;
+}
+
+} // namespace
+
+// ----- CDPHandler::Impl ------------------------------------------------------
+
+class CDPHandler::Impl {
+ public:
+  std::unique_ptr<RuntimeAdapter> adapter;
+  std::string title;
+  std::shared_ptr<State> initialState;
+  CDPHandlerSessionConfig sessionConfig;
+  std::optional<CDPHandlerExecutionContextDescription> ecDesc;
+  bool waitForDebugger{false};
+
+  // Constructed lazily in registerCallbacks (we need the message callback
+  // to build the CDPAgent), torn down in unregisterCallbacks/dtor.
+  std::unique_ptr<facebook::hermes::cdp::CDPAgent> agent;
+  bool didAcquireDebugAPI{false};
+  OnUnregisterFunction onUnregister;
+
+  ~Impl() {
+    if (agent) {
+      agent.reset();
+    }
+    if (didAcquireDebugAPI && adapter) {
+      registry().release(adapter->getRuntime());
+    }
+  }
+};
+
+// ----- CDPHandler ------------------------------------------------------------
+
+CDPHandler::CDPHandler() : impl_(std::make_unique<Impl>()) {}
+
+CDPHandler::~CDPHandler() = default;
+
+std::shared_ptr<CDPHandler> CDPHandler::create(
+    std::unique_ptr<RuntimeAdapter> adapter,
+    bool waitForDebugger,
+    bool /*processConsoleAPI*/,
+    std::shared_ptr<State> state,
+    const CDPHandlerSessionConfig& sessionConfig,
+    std::optional<CDPHandlerExecutionContextDescription> ec) {
+  auto handler = std::shared_ptr<CDPHandler>(new CDPHandler());
+  handler->impl_->adapter = std::move(adapter);
+  handler->impl_->initialState = std::move(state);
+  handler->impl_->sessionConfig = sessionConfig;
+  handler->impl_->ecDesc = std::move(ec);
+  handler->impl_->waitForDebugger = waitForDebugger;
+  return handler;
+}
+
+std::shared_ptr<CDPHandler> CDPHandler::create(
+    std::unique_ptr<RuntimeAdapter> adapter,
+    const std::string& title,
+    bool waitForDebugger,
+    bool processConsoleAPI,
+    std::shared_ptr<State> state,
+    const CDPHandlerSessionConfig& sessionConfig,
+    std::optional<CDPHandlerExecutionContextDescription> ec) {
+  auto handler = create(
+      std::move(adapter),
+      waitForDebugger,
+      processConsoleAPI,
+      std::move(state),
+      sessionConfig,
+      std::move(ec));
+  handler->impl_->title = title;
+  return handler;
+}
+
+std::string CDPHandler::getTitle() const {
+  return impl_->title;
+}
+
+bool CDPHandler::registerCallbacks(
+    CDPMessageCallbackFunction messageCallback,
+    OnUnregisterFunction onUnregister) {
+  if (impl_->agent) {
+    // Old API contract: only one connection at a time.
+    return false;
+  }
+
+  HermesRuntime& runtime = impl_->adapter->getRuntime();
+  auto& debugAPI = registry().acquire(runtime);
+  impl_->didAcquireDebugAPI = true;
+
+  // Bind the V1 EnqueueRuntimeTaskFunc to the adapter's runtime-thread
+  // task queue. Capturing a raw pointer to the adapter is safe for the
+  // CDPAgent's lifetime: the agent is destroyed (via unregisterCallbacks
+  // or ~Impl) before the adapter unique_ptr is.
+  RuntimeAdapter* adapterPtr = impl_->adapter.get();
+  facebook::hermes::debugger::EnqueueRuntimeTaskFunc enqueue =
+      [adapterPtr](facebook::hermes::debugger::RuntimeTask task) {
+        adapterPtr->enqueueRuntimeTask(std::move(task));
+      };
+
+  int32_t executionContextID =
+      impl_->ecDesc ? impl_->ecDesc->id : /*default*/ 1;
+
+  impl_->agent = facebook::hermes::cdp::CDPAgent::create(
+      executionContextID,
+      debugAPI,
+      std::move(enqueue),
+      std::move(messageCallback));
+
+  // Old API auto-enabled the Debugger domain on construction; mirror that
+  // so set-and-forget breakpoint registration works without a prior
+  // explicit `Debugger.enable` from the front-end.
+  impl_->agent->enableDebuggerDomain();
+  if (impl_->sessionConfig.isRuntimeDomainEnabled) {
+    impl_->agent->enableRuntimeDomain();
+  }
+
+  impl_->onUnregister = std::move(onUnregister);
+  return true;
+}
+
+bool CDPHandler::unregisterCallbacks() {
+  if (!impl_->agent) {
+    return false;
+  }
+  impl_->agent.reset();
+  if (impl_->didAcquireDebugAPI) {
+    registry().release(impl_->adapter->getRuntime());
+    impl_->didAcquireDebugAPI = false;
+  }
+  auto cb = std::move(impl_->onUnregister);
+  impl_->onUnregister = nullptr;
+  if (cb) {
+    cb();
+  }
+  return true;
+}
+
+void CDPHandler::handle(std::string message) {
+  if (impl_->agent) {
+    impl_->agent->handleCommand(std::move(message));
+  }
+}
+
+std::unique_ptr<State> CDPHandler::getState() {
+  // MVP: we don't translate V1 cdp::State across the shim boundary.
+  // Returning nullptr means breakpoints are lost on reload, which is
+  // documented as a known limitation in CDP_ADAPTER_PLAN.md (open
+  // question 4 / risk 3).
+  return nullptr;
+}
+
+} // namespace chrome
+} // namespace inspector_modern
+} // namespace hermes
+} // namespace facebook
